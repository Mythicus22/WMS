CREATE TABLE UserEntity (
    id TEXT PRIMARY KEY NOT NULL,
    username TEXT NOT NULL UNIQUE,
    passwordHash TEXT NOT NULL,
    role TEXT NOT NULL,
    grantedFeaturesCsv TEXT NOT NULL,
    grantedSettingsCsv TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

insertUser:
INSERT OR REPLACE INTO UserEntity(id, username, passwordHash, role, grantedFeaturesCsv, grantedSettingsCsv, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

getUserByUsername:
SELECT * FROM UserEntity WHERE username = ?;

getUserById:
SELECT * FROM UserEntity WHERE id = ?;

getAllUsers:
SELECT * FROM UserEntity;

updateUser:
UPDATE UserEntity
SET username = ?,
    passwordHash = ?,
    role = ?,
    grantedFeaturesCsv = ?,
    grantedSettingsCsv = ?
WHERE id = ?;

deleteUserById:
DELETE FROM UserEntity WHERE id = ?;

getUserCount:
SELECT count(*) FROM UserEntity;

CREATE TABLE ShuttleEntity (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    plcIpAddress TEXT NOT NULL,
    mqttPublishTopic TEXT NOT NULL,
    mqttSubscribeTopic TEXT NOT NULL,
    communicationTimeout INTEGER NOT NULL,
    heartbeatInterval INTEGER NOT NULL,
    firmwareVersion TEXT NOT NULL,
    isEnabled INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

insertShuttle:
INSERT OR REPLACE INTO ShuttleEntity(
    id, name, description, plcIpAddress, mqttPublishTopic, mqttSubscribeTopic,
    communicationTimeout, heartbeatInterval, firmwareVersion, isEnabled, createdAt, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllShuttles:
SELECT * FROM ShuttleEntity;

getShuttleById:
SELECT * FROM ShuttleEntity WHERE id = ?;

deleteShuttleById:
DELETE FROM ShuttleEntity WHERE id = ?;

updateShuttleStatus:
UPDATE ShuttleEntity SET isEnabled = ?, updatedAt = ? WHERE id = ?;

getShuttleCounts:
SELECT 
    COUNT(*) AS total,
    SUM(CASE WHEN isEnabled = 1 THEN 1 ELSE 0 END) AS enabled,
    SUM(CASE WHEN isEnabled = 0 THEN 1 ELSE 0 END) AS disabled
FROM ShuttleEntity;
