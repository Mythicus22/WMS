CREATE TABLE UserEntity (
    id TEXT PRIMARY KEY NOT NULL,
    username TEXT NOT NULL UNIQUE,
    passwordHash TEXT NOT NULL,
    role TEXT NOT NULL,
    grantedFeaturesCsv TEXT NOT NULL,
    grantedSettingsCsv TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

insertUser:
INSERT OR REPLACE INTO UserEntity(id, username, passwordHash, role, grantedFeaturesCsv, grantedSettingsCsv, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

getUserByUsername:
SELECT * FROM UserEntity WHERE username = ?;

getUserById:
SELECT * FROM UserEntity WHERE id = ?;

getAllUsers:
SELECT * FROM UserEntity;

updateUser:
UPDATE UserEntity
SET username = ?,
    passwordHash = ?,
    role = ?,
    grantedFeaturesCsv = ?,
    grantedSettingsCsv = ?
WHERE id = ?;

deleteUserById:
DELETE FROM UserEntity WHERE id = ?;

getUserCount:
SELECT count(*) FROM UserEntity;

CREATE TABLE DeviceAliasEntity (
    deviceId TEXT PRIMARY KEY NOT NULL,
    alias TEXT,
    notes TEXT,
    updatedAt INTEGER NOT NULL
);

insertDeviceAlias:
INSERT OR REPLACE INTO DeviceAliasEntity(
    deviceId, alias, notes, updatedAt
) VALUES (?, ?, ?, ?);

getDeviceAlias:
SELECT * FROM DeviceAliasEntity WHERE deviceId = ?;

getAllDeviceAliases:
SELECT * FROM DeviceAliasEntity;

deleteDeviceAlias:
DELETE FROM DeviceAliasEntity WHERE deviceId = ?;

deleteAllDeviceAliases:
DELETE FROM DeviceAliasEntity;

CREATE TABLE RegisteredShuttleEntity (
    deviceId TEXT PRIMARY KEY NOT NULL,
    serialNumber TEXT NOT NULL,
    displayName TEXT NOT NULL,
    protocolVersion TEXT NOT NULL,
    firmwareVersion TEXT NOT NULL,
    hardwareVersion TEXT NOT NULL,
    manufacturer TEXT NOT NULL,
    status TEXT NOT NULL,
    lastSeenAt INTEGER NOT NULL
);

insertRegisteredShuttle:
INSERT OR REPLACE INTO RegisteredShuttleEntity(
    deviceId, serialNumber, displayName, protocolVersion, firmwareVersion,
    hardwareVersion, manufacturer, status, lastSeenAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllRegisteredShuttles:
SELECT * FROM RegisteredShuttleEntity;

deleteRegisteredShuttle:
DELETE FROM RegisteredShuttleEntity WHERE deviceId = ?;

deleteAllRegisteredShuttles:
DELETE FROM RegisteredShuttleEntity;

CREATE TABLE SettingsEntity (
    id TEXT PRIMARY KEY NOT NULL,
    jsonValue TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

insertSetting:
INSERT OR REPLACE INTO SettingsEntity(id, jsonValue, updatedAt)
VALUES (?, ?, ?);

getSettingById:
SELECT * FROM SettingsEntity WHERE id = ?;

deleteSettingById:
DELETE FROM SettingsEntity WHERE id = ?;

deleteAllSettings:
DELETE FROM SettingsEntity;

CREATE TABLE ActiveShuttleEntity (
    id TEXT PRIMARY KEY NOT NULL,
    deviceId TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

insertActiveShuttle:
INSERT OR REPLACE INTO ActiveShuttleEntity(id, deviceId, updatedAt)
VALUES (?, ?, ?);

getActiveShuttle:
SELECT * FROM ActiveShuttleEntity WHERE id = ?;

deleteActiveShuttle:
DELETE FROM ActiveShuttleEntity WHERE id = ?;

deleteAllActiveShuttles:
DELETE FROM ActiveShuttleEntity;
